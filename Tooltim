# ══════════════════════════════════════════════════
#   VRAI DÉGRADÉ RGB — interpolation caractère/ligne
# ══════════════════════════════════════════════════

def rgb(r, g, b):
    """Retourne le code ANSI 24-bit pour une couleur RGB."""
    return f"\x1b[38;2;{r};{g};{b}m"

RESET = "\x1b[0m"

def interpolate_color(c1, c2, t):
    """Interpole linéairement entre deux couleurs RGB. t ∈ [0.0, 1.0]"""
    return (
        int(c1[0] + (c2[0] - c1[0]) * t),
        int(c1[1] + (c2[1] - c1[1]) * t),
        int(c1[2] + (c2[2] - c1[2]) * t),
    )

def gradient_text(text, colors):
    """
    Applique un dégradé horizontal sur `text` en passant par la liste `colors`.
    `colors` est une liste de tuples (R, G, B).
    """
    if not text:
        return ""
    segments = len(colors) - 1
    length = len(text)
    result = ""
    for i, ch in enumerate(text):
        t_global = i / max(length - 1, 1)
        seg = min(int(t_global * segments), segments - 1)
        t_local = t_global * segments - seg
        r, g, b = interpolate_color(colors[seg], colors[seg + 1], t_local)
        result += rgb(r, g, b) + ch
    return result + RESET

def center_text(text):
    """Centre le texte (ignore les codes ANSI pour le calcul de la largeur)."""
    import re
    ansi_escape = re.compile(r'\x1b\[[0-9;]*m')
    visible = ansi_escape.sub('', text)
    terminal_width = shutil.get_terminal_size((80, 24)).columns
    pad = max((terminal_width - len(visible)) // 2, 0)
    return " " * pad + text

# Palette dégradé : violet → rouge → orange → jaune → cyan
PALETTE = [
    (148, 0,   211),   # violet
    (255, 0,   100),   # rose-rouge
    (255, 80,  0  ),   # orange
    (255, 220, 0  ),   # jaune
    (0,   200, 255),   # cyan
]

def grad(text):
    """Raccourci : applique le dégradé principal."""
    return gradient_text(text, PALETTE)

# Couleurs utilitaires simples (sans dépendance externe)
def blue(t):    return f"\x1b[38;2;80;180;255m{t}{RESET}"
def green(t):   return f"\x1b[38;2;80;255;130m{t}{RESET}"
def red(t):     return f"\x1b[38;2;255;80;80m{t}{RESET}"
def yellow(t):  return f"\x1b[38;2;255;220;50m{t}{RESET}"
def cyan(t):    return f"\x1b[38;2;0;220;220m{t}{RESET}"
def purple(t):  return f"\x1b[38;2;180;80;255m{t}{RESET}"

