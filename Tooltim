def traceroute_host(ip, max_hops=30):
    print(blue(f"\n[*] Traceroute vers {ip}..."))
    try:
        if platform.system() == "Windows":
            result = subprocess.run(
                f"tracert -h {max_hops} {ip}",
                capture_output=True, text=True, shell=True)
        else:
            result = subprocess.run(
                f"traceroute -m {max_hops} {ip}",
                capture_output=True, text=True, shell=True)
        return result.stdout.splitlines()
    except Exception as e:
        return [f"Erreur: {e}"]

# ══════════════════════════════════════════════════
#   SCAN TCP SYN
# ══════════════════════════════════════════════════

def syn_scan(ip, ports=None):
    from scapy.all import IP, TCP, srp1
    if ports is None:
        ports = [21, 22, 23, 25, 53, 80, 110, 143, 443, 445, 3389, 8080]
    else:
        ports = [int(p) for p in ports.split(",")]
    print(blue(f"\n[*] Scan TCP SYN sur {ip}..."))
    open_ports = []
    for port in tqdm(ports, desc="Scanning", unit="port"):
        try:
            packet   = IP(dst=ip) / TCP(dport=port, flags="S")
            response = srp1(packet, timeout=1, verbose=0)
            if response and response.haslayer(TCP) and response.getlayer(TCP).flags == 0x12:
                open_ports.append(port)
                srp1(IP(dst=ip) / TCP(dport=port, flags="R"), timeout=1, verbose=0)
        except:
            continue
    return open_ports if open_ports else ["Aucun port ouvert trouvé."]

# ══════════════════════════════════════════════════
#   SCAN UDP
# ══════════════════════════════════════════════════

def udp_scan(ip, ports=None):
    from scapy.all import IP, UDP, srp1
    if ports is None:
        ports = [53, 67, 68, 69, 123, 137, 138, 161, 162, 500, 514, 520]
    else:
        ports = [int(p) for p in ports.split(",")]
    print(blue(f"\n[*] Scan UDP sur {ip}..."))
    open_ports = []
    for port in tqdm(ports, desc="Scanning", unit="port"):
        try:
            packet   = IP(dst=ip) / UDP(dport=port)
            response = srp1(packet, timeout=2, verbose=0)
            if response is None:
                open_ports.append(port)
        except:
            continue
    return open_ports if open_ports else ["Aucun port UDP ouvert trouvé."]

# ══════════════════════════════════════════════════
#   DÉTECTION FIREWALL
# ══════════════════════════════════════════════════

def detect_firewall(ip):
    print(blue(f"\n[*] Détection de firewall sur {ip}..."))
    filtered_ports = []
    common_ports = [21, 22, 23, 25, 80, 110, 143, 443, 445, 3389]
    for port in common_ports:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(1)
        result = sock.connect_ex((ip, port))
        if result != 0:
            filtered_ports.append(port)
        sock.close()
    return filtered_ports if filtered_ports else ["Aucun port filtré détecté."]

# ══════════════════════════════════════════════════
#   DÉTECTION MTU
# ══════════════════════════════════════════════════

def detect_mtu(ip):
    print(blue(f"\n[*] Détection de MTU vers {ip}..."))
    try:
        if platform.system() == "Windows":
            result = subprocess.run(
                f"ping -f -l 1472 {ip}", capture_output=True, text=True, shell=True)
        else:
            result = subprocess.run(
                f"ping -M do -s 1472 -c 1 {ip}", capture_output=True, text=True, shell=True)
        if "fragmentation needed" in result.stderr.lower() or "Frag needed" in result.stdout:
            return "MTU < 1500 (fragmentation requise)"
        else:
            return "MTU >= 1500 (pas de fragmentation)"
    except Exception as e:
        return f"Erreur: {e}"

