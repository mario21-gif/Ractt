def exporter_resultats(data, format="txt", nom_fichier=None):
    if not nom_fichier:
        nom_fichier = f"scan_resultats_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
    if format == "json":
        with open(f"{nom_fichier}.json", "w", encoding="utf-8") as f:
            json.dump(data, f, indent=4, ensure_ascii=False)
    elif format == "csv":
        with open(f"{nom_fichier}.csv", "w", newline='', encoding="utf-8") as f:
            writer = csv.writer(f)
            if isinstance(data, list) and data and isinstance(data[0], dict):
                writer.writerow(data[0].keys())
                for row in data:
                    writer.writerow(row.values())
            else:
                writer.writerow(["Données", str(data)])
    else:
        with open(f"{nom_fichier}.txt", "w", encoding="utf-8") as f:
            f.write(str(data))
    print(green(f"\n[+] Résultats exportés → {nom_fichier}.{format}"))

# ══════════════════════════════════════════════════
#   SCAN IP — Infos complètes sur une IP
# ══════════════════════════════════════════════════

def scan_ip(ip):
    print(blue(f"\n[*] Scan IP de {ip}..."))
    resultats = {}

    # Résolution DNS
    try:
        hostname = socket.gethostbyaddr(ip)[0]
        resultats["Hostname"] = hostname
    except:
        resultats["Hostname"] = "N/A"

    # Géolocalisation + infos via ipinfo.io
    try:
        r = requests.get(f"https://ipinfo.io/{ip}/json", timeout=5)
        data = r.json()
        resultats["IP"]           = data.get("ip", ip)
        resultats["Ville"]        = data.get("city", "N/A")
        resultats["Région"]       = data.get("region", "N/A")
        resultats["Pays"]         = data.get("country", "N/A")
        resultats["Organisation"] = data.get("org", "N/A")
        resultats["FAI"]          = data.get("org", "N/A")
        resultats["Timezone"]     = data.get("timezone", "N/A")
        resultats["Localisation"] = data.get("loc", "N/A")
        resultats["Code postal"]  = data.get("postal", "N/A")
    except Exception as e:
        resultats["Géoloc"] = f"Erreur: {e}"

    # Ping rapide (statut)
    if platform.system() == "Windows":
        r = os.system(f"ping -n 1 -w 500 {ip} > nul 2>&1")
    else:
        r = os.system(f"ping -c 1 -W 1 {ip} > /dev/null 2>&1")
    resultats["Statut"] = green("En ligne ✔") if r == 0 else red("Hors ligne ✘")

    # Ports ouverts rapides (top 10)
    ports_communs = [21, 22, 23, 25, 53, 80, 443, 3306, 3389, 8080]
    ouverts = []
    for port in ports_communs:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(0.5)
        if s.connect_ex((ip, port)) == 0:
            ouverts.append(port)
        s.close()
    resultats["Ports ouverts (top 10)"] = ouverts if ouverts else ["Aucun"]

    # Affichage
    print()
    print(grad("  ┌─── Résultats Scan IP ────────────────────────┐"))
    for cle, val in resultats.items():
        if cle == "Statut":
            print(f"  │  {yellow(cle+':')<30}  {val}")
        else:
            print(f"  │  {yellow(cle+':'):<30}  {val}")
    print(grad("  └──────────────────────────────────────────────┘"))

    return {k: str(v) for k, v in resultats.items()}

