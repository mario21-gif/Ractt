def get_local_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        local_ip = s.getsockname()[0]
        s.close()
        return local_ip
    except:
        return "127.0.0.1"

# ══════════════════════════════════════════════════
#   SCAN ARP
# ══════════════════════════════════════════════════

def scan_arp(plage_ip):
    try:
        from scapy.all import ARP, Ether, srp
        print(blue(f"\n[*] Scan ARP sur {plage_ip}..."))
        arp    = ARP(pdst=plage_ip)
        ether  = Ether(dst="ff:ff:ff:ff:ff:ff")
        paquet = ether / arp
        result = srp(paquet, timeout=2, verbose=0)[0]
        appareils = []
        for sent, received in result:
            appareils.append({
                "ip":     received.psrc,
                "mac":    received.hwsrc,
                "vendor": get_vendor(received.hwsrc)
            })
        return appareils if appareils else [{"info": "Aucun appareil trouvé."}]
    except Exception as e:
        return [{"error": f"Erreur: {e}"}]

def get_vendor(mac):
    try:
        with open("vendors.json", "r") as f:
            vendors = json.load(f)
        prefix = mac[:8].upper().replace(":", "")
        return vendors.get(prefix, "Inconnu")
    except:
        return "Inconnu"

# ══════════════════════════════════════════════════
#   PING SWEEP
# ══════════════════════════════════════════════════

def ping_sweep(plage_ip):
    try:
        from scapy.all import ip_network
    except ImportError:
        from ipaddress import ip_network
    print(blue(f"\n[*] Ping Sweep sur {plage_ip}..."))
    hosts_up = []
    for ip in ip_network(plage_ip, strict=False).hosts():
        ip_str = str(ip)
        if platform.system() == "Windows":
            response = os.system(f"ping -n 1 -w 100 {ip_str} > nul 2>&1")
        else:
            response = os.system(f"ping -c 1 -W 1 {ip_str} > /dev/null 2>&1")
        if response == 0:
            hosts_up.append(ip_str)
    return hosts_up if hosts_up else ["Aucun hôte actif trouvé."]

