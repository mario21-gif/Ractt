        return f"Erreur: {e}"

# ══════════════════════════════════════════════════
#   DÉTECTION NAT
# ══════════════════════════════════════════════════

def detect_nat():
    print(blue("\n[*] Détection de NAT..."))
    try:
        public_ip  = requests.get("https://api.ipify.org", timeout=5).text.strip()
        private_ip = get_local_ip()
        if public_ip != private_ip:
            return f"NAT détecté  (IP publique: {public_ip}  /  IP privée: {private_ip})"
        else:
            return "Pas de NAT détecté (IP publique = IP privée)"
    except Exception as e:
        return f"Erreur: {e}"

# ══════════════════════════════════════════════════
#   DÉTECTION ROUTEURS (TTL)
# ══════════════════════════════════════════════════

def detect_routeurs(ip):
    print(blue(f"\n[*] Détection de routeurs via TTL vers {ip}..."))
    try:
        if platform.system() == "Windows":
            result = subprocess.run(
                f"ping -n 1 {ip}", capture_output=True, text=True, shell=True)
        else:
            result = subprocess.run(
                f"ping -c 1 {ip}", capture_output=True, text=True, shell=True)
        ttl_line = [line for line in result.stdout.splitlines() if "TTL=" in line or "ttl=" in line.lower()]
        if ttl_line:
            raw = ttl_line[0].lower().split("ttl=")[1].split()[0].strip()
            ttl = int(''.join(filter(str.isdigit, raw)))
            if ttl <= 64:
                return f"Routeur Linux/Unix probable (TTL={ttl})"
            elif ttl <= 128:
                return f"Routeur Windows probable (TTL={ttl})"
            else:
                return f"Équipement réseau (TTL={ttl} élevé)"
        else:
            return "TTL non détecté (hôte injoignable ?)"
    except Exception as e:
        return f"Erreur: {e}"

# ══════════════════════════════════════════════════
#   SNIFFER RÉSEAU
# ══════════════════════════════════════════════════

def sniffer_reseau(interface, count=10, filtre=None):
    from scapy.all import sniff
    print(blue(f"\n[*] Sniffing sur {interface} ({count} paquets)..."))
    try:
        kwargs = {"iface": interface, "count": count}
        if filtre:
            kwargs["filter"] = filtre
        paquets = sniff(**kwargs)
        return [p.summary() for p in paquets]
    except Exception as e:
        return [f"Erreur: {e}. Vérifiez l'interface ou les permissions (root)."]

