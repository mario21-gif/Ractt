def test_latence(ip, count=4):
    print(blue(f"\n[*] Test de latence vers {ip}..."))
    try:
        if platform.system() == "Windows":
            result = subprocess.run(
                f"ping -n {count} {ip}", capture_output=True, text=True, shell=True)
        else:
